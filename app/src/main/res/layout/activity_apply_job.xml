<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Page Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/job_application"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:layout_marginBottom="10dp" />

        <!-- Selected Job -->
        <TextView
            android:id="@+id/tvApplyJobTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/job_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="20dp" />

        <!-- Full Name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/full_name"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etFullName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/enter_full_name"
            android:autofillHints="name"
            android:inputType="textPersonName"
            android:layout_marginBottom="15dp" />

        <!-- Email -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/email"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/enter_email"
            android:autofillHints="emailAddress"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="15dp" />

        <!-- Phone -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/phone_number"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/enter_phone_number"
            android:autofillHints="phoneNumber"
            android:inputType="phone"
            android:layout_marginBottom="15dp" />

        <!-- Qualification -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/qualification"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etQualification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/enter_qualification"
            android:autofillHints=""
            android:inputType="text"
            android:layout_marginBottom="15dp" />

        <!-- Experience -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/experience"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etExperience"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/enter_experience"
            android:autofillHints=""
            android:inputType="text"
            android:layout_marginBottom="15dp" />

        <!-- Skills -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/skills"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etSkills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/enter_skills"
            android:autofillHints=""
            android:inputType="text"
            android:layout_marginBottom="15dp" />

        <!-- Certifications -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/certifications"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCertifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/enter_certifications"
            android:autofillHints=""
            android:inputType="text"
            android:layout_marginBottom="15dp" />

        <!-- Cover Letter -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cover_letter"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCoverLetter"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="@string/write_cover_letter"
            android:autofillHints=""
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:layout_marginBottom="25dp" />

        <!-- Submit Application -->
        <Button
            android:id="@+id/btnSubmitApplication"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/submit_application"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>