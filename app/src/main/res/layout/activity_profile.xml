<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/my_profile"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:layout_marginBottom="25dp" />

        <!-- Full Name -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/full_name"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etProfileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/enter_full_name"
            android:autofillHints="name"
            android:inputType="textPersonName"
            android:layout_marginBottom="15dp" />

        <!-- Email -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/email"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etProfileEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/enter_email"
            android:autofillHints="emailAddress"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="15dp" />

        <!-- Phone -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/phone_number"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etProfilePhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/enter_phone_number"
            android:autofillHints="phoneNumber"
            android:inputType="phone"
            android:layout_marginBottom="15dp" />

        <!-- Qualification -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/qualification"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etProfileQualification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_qualification_example"
            android:autofillHints=""
            android:inputType="text"
            android:layout_marginBottom="15dp" />

        <!-- Experience -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/experience"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etProfileExperience"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_experience_example"
            android:autofillHints=""
            android:inputType="text"
            android:layout_marginBottom="15dp" />

        <!-- Skills -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/skills"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etProfileSkills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_skills_example"
            android:autofillHints=""
            android:inputType="text"
            android:layout_marginBottom="15dp" />

        <!-- Certifications -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/certifications"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etProfileCertifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_certifications_example"
            android:autofillHints=""
            android:inputType="text"
            android:layout_marginBottom="25dp" />

        <!-- Save Profile -->

        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_profile"
            android:textSize="16sp" />

        <!-- Logout -->

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/logout"
            android:textSize="16sp"
            android:layout_marginTop="15dp" />

    </LinearLayout>

</ScrollView>